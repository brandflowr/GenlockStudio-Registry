{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/bone.schema.json",
  "bone_id": "elevenlabs-tts",
  "bone_version": "1.2.0",
  "label": "ElevenLabs · Text to Speech",
  "description": "Turn dialogue or narration into a project audio asset using a voice from your ElevenLabs account.",
  "provider": "elevenlabs",
  "target": "audio",
  "requires": [
    "speech_generation"
  ],
  "attaches_to": [
    "metadata",
    "scene",
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Dialogue or narration",
      "description": "The exact words to speak."
    },
    "voice_id": {
      "type": "string",
      "required": true,
      "ui": "select",
      "label": "Voice",
      "description": "Voices are loaded from the connected ElevenLabs account."
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Model",
      "default": "eleven_multilingual_v2",
      "options": [
        "eleven_v3",
        "eleven_multilingual_v2"
      ]
    },
    "stability": {
      "type": "number",
      "required": false,
      "ui": "slider",
      "label": "Stability",
      "description": "Lower values are more expressive; higher values stay more consistent.",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "similarity_boost": {
      "type": "number",
      "required": false,
      "ui": "slider",
      "label": "Voice likeness",
      "description": "How strongly the result should follow the selected voice.",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    "style": {
      "type": "number",
      "required": false,
      "ui": "slider",
      "label": "Style",
      "description": "Amplify the performance style encoded by the selected voice.",
      "default": 0,
      "min": 0,
      "max": 1
    },
    "use_speaker_boost": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "label": "Speaker boost",
      "description": "Strengthen similarity to the selected speaker.",
      "default": true
    },
    "output_format": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Audio quality",
      "default": "mp3_44100_128",
      "options": [
        "mp3_44100_128",
        "mp3_44100_192",
        "wav_44100",
        "pcm_44100"
      ]
    }
  },
  "defaults": {
    "model": "eleven_multilingual_v2",
    "stability": 0.5,
    "similarity_boost": 0.75,
    "style": 0,
    "use_speaker_boost": true,
    "output_format": "mp3_44100_128"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 5000
  },
  "output": {
    "format": "mp3",
    "target": "audio_take",
    "completion_status": "review"
  },
  "execution_routes": [
    {
      "type": "api",
      "label": "ElevenLabs Text to Speech",
      "operation": "speech_generation",
      "args": {
        "text": "{{assembled}}",
        "voice_id": "{{voice_id}}",
        "model_id": "{{model}}",
        "output_format": "{{output_format}}"
      }
    }
  ],
  "routing": {
    "server_id": "elevenlabs"
  },
  "llm_instructions": {
    "writing_guide": "Keep the requested wording intact. Use punctuation to shape delivery, and never put voice ids or credentials into the spoken text.",
    "do": [
      "Select a real voice from the connected account",
      "Keep narration ready to perform"
    ],
    "dont": [
      "Invent voice ids",
      "Put credentials in the BONE"
    ]
  },
  "extensions": {
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "voice-booth",
      "accent": "violet",
      "tagline": "Choose a voice from the connected account, direct the performance, and audition the finished take without leaving the booth.",
      "controls": {
        "voice_id": {
          "kind": "voice-cards",
          "source": "voices",
          "prominent": true
        },
        "prompt": {
          "kind": "prompt-canvas",
          "label": "Script",
          "prominent": true,
          "hint": "Punctuation and spacing shape the performance"
        },
        "model": {
          "kind": "choice-chips"
        },
        "stability": {
          "kind": "slider"
        },
        "similarity_boost": {
          "kind": "slider"
        },
        "style": {
          "kind": "slider"
        },
        "use_speaker_boost": {
          "kind": "switch"
        },
        "output_format": {
          "kind": "choice-chips"
        }
      },
      "groups": [
        {
          "id": "casting",
          "label": "Voice and script",
          "role": "primary",
          "fields": [
            "voice_id",
            "prompt"
          ]
        },
        {
          "id": "performance",
          "label": "Performance",
          "role": "performance",
          "fields": [
            "stability",
            "similarity_boost",
            "style",
            "use_speaker_boost"
          ]
        },
        {
          "id": "delivery",
          "label": "Audio delivery",
          "role": "delivery",
          "fields": [
            "model",
            "output_format"
          ]
        }
      ],
      "output": {
        "kind": "audio",
        "label": "Voice take"
      }
    },
    "x-genlock-provider-source": {
      "server_id": "elevenlabs",
      "operation": "speech_generation",
      "transport": "api",
      "surface": "ElevenLabs Text to Speech"
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.2.0"
    }
  }
}
