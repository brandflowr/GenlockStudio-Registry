{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "gpt-image",
  "bone_version": "1.0.0",
  "label": "GPT Image",
  "description": "OpenAI image generation (GPT Image 2 / DALL·E lineage) with strong instruction following and editing.",
  "target": "image",
  "provider": "openai",
  "attaches_to": [
    "shot",
    "scene",
    "metadata"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "gpt-image-2",
      "options": [
        "gpt-image-2",
        "dall-e-3"
      ],
      "label": "Model"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4",
        "3:2",
        "2:3"
      ],
      "label": "Aspect Ratio"
    },
    "quality": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "high",
      "options": [
        "low",
        "medium",
        "high"
      ],
      "label": "Quality"
    },
    "image_references": {
      "type": "array",
      "required": false,
      "ui": "file",
      "label": "Reference / Edit Images",
      "items": {
        "type": "string"
      }
    },
    "negative_prompt": {
      "type": "string",
      "required": false,
      "ui": "textarea",
      "label": "Negative Prompt"
    }
  },
  "defaults": {
    "model": "gpt-image-2",
    "aspect_ratio": "16:9",
    "quality": "high"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for OpenAI GPT Image / DALL·E generation.\n\nRules:\n- Be clear and explicit. This family follows instructions closely.\n- Describe composition, subject, lighting, and style in natural language.\n- When reference images are provided, state how they should be used (style, identity, composition).\n- Avoid conflicting instructions.\n- Output only field values."
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "routing": {
    "supported_models": [
      "gpt-image-2",
      "gpt_image_2",
      "dall-e-3"
    ]
  },
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "gpt-image",
      "execution_route": "api",
      "output": {
        "type": "image",
        "write_back": [
          "startFrameImage",
          "endFrameImage",
          "asset"
        ]
      }
    }
  }
}
