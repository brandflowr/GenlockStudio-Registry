{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "recraft-image",
  "bone_version": "1.0.0",
  "label": "Recraft Image",
  "description": "Design-focused image generation via Recraft (strong for illustration, vector, and brand-consistent work).",
  "target": "image",
  "provider": "recraft",
  "attaches_to": [
    "shot",
    "scene",
    "metadata"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt"
    },
    "style": {
      "type": "string",
      "required": false,
      "ui": "select",
      "options": [
        "realistic_image",
        "digital_illustration",
        "vector_illustration",
        "icon",
        "logo"
      ],
      "label": "Style"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4",
        "3:2",
        "2:3"
      ],
      "label": "Aspect Ratio"
    },
    "colors": {
      "type": "array",
      "required": false,
      "ui": "text",
      "label": "Brand Colors (hex)",
      "items": {
        "type": "string"
      }
    },
    "negative_prompt": {
      "type": "string",
      "required": false,
      "ui": "textarea",
      "label": "Negative Prompt"
    }
  },
  "defaults": {
    "aspect_ratio": "16:9"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for Recraft (design-oriented image generation).\n\nRules:\n- Be explicit about style intent (photoreal, illustration, vector, icon, logo).\n- When brand colors are supplied, respect them.\n- Recraft is strong at clean, controlled design language — avoid overly chaotic prompts.\n- Output only field values."
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "routing": {
    "supported_models": [
      "recraft-v3",
      "recraft_v4_1"
    ]
  },
  "execution_routes": [
    {
      "type": "manual",
      "label": "Configure recraft execution in Genlock"
    }
  ],
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "recraft-image",
      "execution_route": "api",
      "output": {
        "type": "image",
        "write_back": [
          "startFrameImage",
          "endFrameImage",
          "asset"
        ]
      }
    }
  }
}
