{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "grok-image",
  "bone_version": "1.0.0",
  "label": "Grok Image",
  "description": "A model-safe xAI Grok Imagine instrument with exact aspect ratio control.",
  "target": "image",
  "provider": "xai",
  "attaches_to": [
    "shot",
    "scene",
    "metadata"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "grok-imagine-image",
      "options": [
        "grok-imagine-image"
      ],
      "label": "Model"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "auto",
      "options": [
        "auto",
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4",
        "3:2",
        "2:3"
      ],
      "label": "Aspect Ratio"
    }
  },
  "defaults": {
    "model": "grok-imagine-image",
    "aspect_ratio": "auto"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 4000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for xAI Grok Imagine image generation.\n\nRules:\n- Describe subject, composition, lighting, and style in clear natural language.\n- Grok Imagine follows direct, concrete instructions closely.\n- Avoid conflicting instructions.\n- Output only field values."
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "routing": {
    "supported_models": [
      "grok-imagine-image"
    ],
    "server_id": "xai"
  },
  "extensions": {
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "image-canvas",
      "accent": "cyan",
      "tagline": "Compose a Grok Imagine render with controls that map exactly to the xAI Images API.",
      "controls": {
        "prompt": {
          "kind": "prompt-canvas",
          "prominent": true
        },
        "model": {
          "kind": "model-cards",
          "source": "models",
          "prominent": true
        },
        "aspect_ratio": {
          "kind": "aspect-tiles"
        }
      },
      "groups": [
        {
          "id": "primary",
          "label": "Image brief",
          "role": "primary",
          "fields": [
            "prompt",
            "model"
          ]
        },
        {
          "id": "delivery",
          "label": "Canvas and delivery",
          "role": "delivery",
          "fields": [
            "aspect_ratio"
          ]
        }
      ],
      "output": {
        "kind": "image",
        "label": "Png output"
      }
    },
    "x-genlock-provider-source": {
      "server_id": "xai",
      "operation": "image_generation",
      "transport": "api",
      "surface": "xAI Images API"
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.0.0"
    }
  },
  "execution_routes": [
    {
      "type": "api",
      "label": "xAI Images API",
      "operation": "image_generation",
      "args": {
        "model": "{{model}}",
        "prompt": "{{assembled}}",
        "aspect_ratio": "{{aspect_ratio}}",
        "response_format": "url"
      }
    }
  ]
}
