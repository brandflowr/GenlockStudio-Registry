{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "higgsfield-voice-change",
  "bone_version": "1.0.0",
  "label": "Higgsfield Voice Change",
  "description": "Replace the voice on an existing video with a chosen preset or custom voice while keeping the original performance timing.",
  "target": "video",
  "provider": "higgsfield",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "video": {
      "type": "string",
      "required": true,
      "ui": "file",
      "label": "Source Video"
    },
    "voice_type": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "preset",
      "options": [
        "preset",
        "element"
      ],
      "label": "Voice Type"
    },
    "voice_id": {
      "type": "string",
      "required": true,
      "ui": "text",
      "label": "Voice ID"
    }
  },
  "defaults": {
    "voice_type": "preset"
  },
  "prompt_assembly": {
    "strategy": "sequential",
    "separator": " ",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "This BONE replaces the spoken voice on a video.\n\n- Require a source video and a valid voice_id.\n- Do not alter the picture or timing.\n- Prefer preset voices unless a custom element voice is explicitly requested.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_edit",
    "audio_generation"
  ],
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "higgsfield-voice-change",
      "execution_route": "cli",
      "cli": {
        "command": "higgsfield generate workflow voice-change"
      },
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  },
  "execution_routes": [
    {
      "type": "cli",
      "label": "Higgsfield CLI — Higgsfield Voice Change",
      "command": "higgsfield generate workflow voice-change",
      "requires": [
        "cli.higgsfield"
      ]
    }
  ]
}
