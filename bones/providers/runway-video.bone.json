{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "runway-video",
  "bone_version": "1.0.0",
  "label": "Runway Video",
  "description": "Cinematic video generation via Runway Gen-3 Alpha Turbo / Gen-4 Turbo / Gen-4 Aleph.",
  "target": "video",
  "provider": "runway",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Motion Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "gen4_turbo",
      "options": [
        "gen3a_turbo",
        "gen4_turbo",
        "gen4_aleph"
      ],
      "label": "Model"
    },
    "start_image": {
      "type": "string",
      "required": false,
      "ui": "file",
      "label": "Start Frame / Image Prompt"
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "number",
      "default": 5,
      "label": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1",
        "21:9"
      ],
      "label": "Aspect Ratio"
    },
    "seed": {
      "type": "number",
      "required": false,
      "ui": "number",
      "label": "Seed"
    },
    "watermark": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "default": false,
      "label": "Watermark"
    }
  },
  "defaults": {
    "model": "gen4_turbo",
    "duration": 5,
    "aspect_ratio": "16:9",
    "watermark": false
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for Runway video generation.\n\nRules:\n- Lead with motion and camera. Runway responds strongly to clear temporal direction.\n- When a start_image is present, describe only the change and motion that should occur from that frame.\n- Use concrete cinematic language (lens feel, lighting motivation, subject action).\n- Avoid long lists of adjectives. Prefer short, vivid clauses.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_generation"
  ],
  "routing": {
    "supported_models": [
      "gen3a_turbo",
      "gen4_turbo",
      "gen4_aleph"
    ]
  },
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "runway-video",
      "execution_route": "api",
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  }
}
