{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "kling-video",
  "bone_version": "1.0.0",
  "label": "Kling Video",
  "description": "High-quality text-to-video and image-to-video via Kling (fal.ai gateway or official API).",
  "target": "video",
  "provider": "kling-official",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Motion Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "kling3_0",
      "options": [
        "kling-v1",
        "kling-v1.5",
        "kling-v2",
        "kling3_0"
      ],
      "label": "Model"
    },
    "endpoint": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "fal",
      "options": [
        "fal",
        "official"
      ],
      "label": "Endpoint"
    },
    "start_image": {
      "type": "string",
      "required": false,
      "ui": "file",
      "label": "Start Frame"
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "number",
      "default": 5,
      "label": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "label": "Aspect Ratio"
    },
    "mode": {
      "type": "string",
      "required": false,
      "ui": "select",
      "options": [
        "std",
        "pro"
      ],
      "label": "Mode"
    },
    "cfg_scale": {
      "type": "number",
      "required": false,
      "ui": "number",
      "label": "CFG Scale"
    },
    "negative_prompt": {
      "type": "string",
      "required": false,
      "ui": "textarea",
      "label": "Negative Prompt"
    }
  },
  "defaults": {
    "model": "kling3_0",
    "endpoint": "fal",
    "duration": 5,
    "aspect_ratio": "16:9"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a motion prompt for Kling video generation.\n\nRules:\n- Always describe camera movement, subject action, and temporal progression.\n- When a start_image is supplied, treat it as the locked first frame and only describe what happens afterward.\n- Prefer precise verbs and camera directions (\"slow dolly in\", \"handheld drift\", \"subject turns and walks into shadow\").\n- Keep the prompt self-contained and cinematic.\n- Avoid static image language.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_generation"
  ],
  "routing": {
    "supported_models": [
      "kling-v1",
      "kling-v1.5",
      "kling-v2",
      "kling3_0"
    ],
    "endpoints": {
      "fal": "fal-ai/kling-video",
      "official": "kling_official"
    },
    "default_endpoint": "fal"
  },
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "kling-video",
      "execution_route": "api",
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  }
}
