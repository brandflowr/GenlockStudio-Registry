          "label": "Video Background Remover"
        },
        {
          "value": "sync_so",
          "label": "Sync Lipsync 3"
        },
        {
          "value": "minimax_hailuo",
          "label": "Minimax Hailuo"
        },
        {
          "value": "minimax_h3",
          "label": "MiniMax H3"
        },
        {
          "value": "minimax_h3_max",
          "label": "MiniMax H3 Max"
        },
        {
          "value": "wan2_6",
          "label": "Wan 2.6 Video"
        },
        {
          "value": "seedance1_5",
          "label": "Seedance 1.5 Pro"
        },
        {
          "value": "seedance_2_0",
          "label": "Seedance 2.0"
        },
        {
          "value": "seedance_2_0_mini",
          "label": "Seedance 2.0 Mini"
        },
        {
          "value": "seedance_2_5",
          "label": "Seedance 2.5"
        },
        {
          "value": "ad_multiplier",
          "label": "Ad Multiplier"
        },
        {
          "value": "topaz_video",
          "label": "Topaz"
        }
      ]
    },
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt",
      "description": "Creative instruction assembled by Genlock."
    },
    "count": {
      "type": "number",
      "required": false,
      "ui": "slider",
      "label": "Count",
      "description": "Number of variants (1-4) generated from this same prompt, inputs, and settings and rendered together in one widget. Use the matching generate_*_batch tool for independent prompts or inputs. Ignored with use_unlim: an unlim request is always one generation — count is capped to 1 and the cap comes back in adjustments.",
      "default": 1,
      "min": 1,
      "max": 4
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "text",
      "label": "Aspect Ratio",
      "description": "Output aspect ratio. Use '9:16' for vertical/portrait platforms (TikTok, Reels, YouTube Shorts) and '16:9' for horizontal/landscape. When omitted the model default applies, which is landscape ('16:9') for Marketing Studio — so pass '9:16' explicitly for TikTok/Reels output. Alternatively pass explicit width/height (e.g. width:1080,height:1920) and the backend derives the aspect ratio."
    },
    "medias": {
      "type": "array",
      "required": false,
      "ui": "text",
      "label": "Medias",
      "description": "Reference media inputs."
    },
    "get_cost": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "label": "Get Cost",
      "description": "If true, return the cost in credits for this generation without submitting any job. Use to preflight cost before generating."
    },
    "use_unlim": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "label": "Use Unlim",
      "description": "Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice`, the question to put to the user before spending anything of theirs. Answer it by calling again with the same params plus this field; the answer is remembered for a few minutes, so a multi-step flow is asked once. true also caps count to 1. Whichever way it is set, a rejected opt-in is reported rather than quietly replaced with a charge."
    },
    "preset_id": {
      "type": "string",
      "required": false,
      "ui": "text",
      "label": "Preset Id",
      "description": "Preset id from presets_show. Use only with model: higgsfield_preset."
    },
    "declined_preset_id": {
      "type": "string",
      "required": false,
      "ui": "text",
      "label": "Declined Preset Id",
      "description": "Preset id declined by the user. Suppresses only that exact preset recommendation for this literal generation retry."
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "slider",
      "label": "Duration",
      "description": "Duration in seconds. Missing → model default. Unsupported → nearest allowed value or clamped to range.",
      "min": -9007199254740991,
      "max": 9007199254740991
    }
  },
  "defaults": {
    "model": "cinematic_studio_3_0",
    "count": 1
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "v_setup_injection": {
      "enabled": true,
      "position": "append",
      "token_format": "natural"
    },
    "character_injection": {
      "enabled": true,
      "position": "prepend",
      "format": "name_and_description"
    },
    "max_length": 4000
  },
  "llm_instructions": {
    "writing_guide": "Write a concrete Higgsfield video prompt for Generate Video. Respect the discovered parameter contract and do not invent unsupported fields.",
    "do": [
      "Use the discovered parameter names",
      "Keep values inside the documented constraints"
    ],
    "dont": [
      "Do not place credentials in the BONE",
      "Do not invent unsupported MCP parameters"
    ]
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_generation"
  ],
  "authoring_mode": "hybrid",
  "execution_routes": [
    {
      "type": "mcp",
      "label": "Higgsfield MCP · Generate Video",
      "tool": "generate_video",
      "operation": "video_generation",
      "args": {
        "params": {
          "model": "{{model}}",
          "prompt": "{{assembled}}",
          "count": "{{count}}",
          "aspect_ratio": "{{aspect_ratio}}",
          "medias": "{{medias}}",
          "get_cost": "{{get_cost}}",
          "use_unlim": "{{use_unlim}}",
          "preset_id": "{{preset_id}}",
          "declined_preset_id": "{{declined_preset_id}}",
          "duration": "{{duration}}"
        }
      }
    }
  ],
  "routing": {
    "server_id": "higgsfield"
  },
