{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/bone.schema.json",
  "bone_id": "higgsfield-generate-video",
  "bone_version": "1.0.0",
  "label": "Higgsfield · Generate Video",
  "description": "Generate one direct video request and render it in the generation widget.",
  "target": "video",
  "provider": "higgsfield",
  "attaches_to": [
    "metadata",
    "scene",
    "shot"
  ],
  "fields": {
    "model": {
      "type": "string",
      "required": true,
      "ui": "select",
      "label": "Model",
      "default": "cinematic_studio_3_0",
      "options": [
        {
          "value": "cinematic_studio_3_0",
          "label": "Cinema Studio Video 3.0"
        },
        {
          "value": "cinematic_studio_video",
          "label": "Cinema Studio Video"
        },
        {
          "value": "cinematic_studio_video_v2",
          "label": "Cinema Studio Video"
        },
        {
