{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "local-video",
  "bone_version": "1.0.0",
  "label": "Local Video",
  "description": "Local / self-hosted video generation (WAN 2.1, Hunyuan, CogVideo, LTX-Video).",
  "target": "video",
  "provider": "local",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Motion Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "wan-2.1",
      "options": [
        "wan-2.1",
        "hunyuan",
        "cogvideo-2b",
        "cogvideo-5b",
        "ltx-video"
      ],
      "label": "Model"
    },
    "start_image": {
      "type": "string",
      "required": false,
      "ui": "file",
      "label": "Start Frame"
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "number",
      "default": 4,
      "label": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "label": "Aspect Ratio"
    },
    "steps": {
      "type": "number",
      "required": false,
      "ui": "number",
      "label": "Steps"
    },
    "seed": {
      "type": "number",
      "required": false,
      "ui": "number",
      "label": "Seed"
    }
  },
  "defaults": {
    "model": "wan-2.1",
    "duration": 4,
    "aspect_ratio": "16:9"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for local video models (WAN, Hunyuan, CogVideo, LTX).\n\nRules:\n- Keep prompts clear and motion-focused. Local models often have tighter context windows than cloud APIs.\n- When a start_image is supplied, describe only the subsequent action.\n- Prefer shorter, concrete prompts over long cinematic paragraphs.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "local_gpu",
    "video_generation"
  ],
  "routing": {
    "supported_models": [
      "wan-2.1",
      "hunyuan",
      "cogvideo-2b",
      "cogvideo-5b",
      "ltx-video"
    ]
  },
  "execution_routes": [
    {
      "type": "manual",
      "label": "Configure local execution in Genlock"
    }
  ],
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "local-video",
      "execution_route": "local",
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  }
}
