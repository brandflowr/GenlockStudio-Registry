{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "minimax-video",
  "bone_version": "1.0.0",
  "label": "MiniMax Video",
  "description": "Cost-effective video generation via MiniMax (Hailuo and related models).",
  "target": "video",
  "provider": "minimax",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Motion Prompt"
    },
    "start_image": {
      "type": "string",
      "required": false,
      "ui": "file",
      "label": "Start Frame"
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "number",
      "default": 5,
      "label": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "label": "Aspect Ratio"
    },
    "prompt_optimizer": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "default": true,
      "label": "Prompt Optimizer"
    }
  },
  "defaults": {
    "duration": 5,
    "aspect_ratio": "16:9",
    "prompt_optimizer": true
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for MiniMax video generation.\n\nRules:\n- Keep prompts clear and motion-oriented.\n- When a start_image is supplied, describe only subsequent action.\n- MiniMax benefits from concise, well-structured prompts rather than very long ones.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_generation"
  ],
  "routing": {
    "supported_models": [
      "minimax-hailuo",
      "minimax_video"
    ]
  },
  "execution_routes": [
    {
      "type": "manual",
      "label": "Configure minimax execution in Genlock"
    }
  ],
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "minimax-video",
      "execution_route": "api",
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  }
}
