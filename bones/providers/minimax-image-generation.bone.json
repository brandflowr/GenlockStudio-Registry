{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/bone.schema.json",
  "bone_id": "minimax-image-generation",
  "bone_version": "1.0.0",
  "label": "MiniMax · Image Generation",
  "description": "Image Generation mapped from MiniMax's reviewed Genlock provider contract.",
  "target": "image",
  "provider": "minimax",
  "attaches_to": [
    "metadata",
    "scene",
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt",
      "description": "Creative instruction assembled by Genlock."
    },
    "model": {
      "type": "string",
      "required": true,
      "ui": "text",
      "label": "Model",
      "description": "Model ID from the model catalog (required)."
    }
  },
  "defaults": {},
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "v_setup_injection": {
      "enabled": true,
      "position": "append",
      "token_format": "natural"
    },
    "character_injection": {
      "enabled": true,
      "position": "prepend",
      "format": "name_and_description"
    },
    "max_length": 4000
  },
  "llm_instructions": {
    "writing_guide": "Write a concrete MiniMax image prompt for Image Generation. Respect the discovered parameter contract and do not invent unsupported fields.",
    "do": [
      "Use the discovered parameter names",
      "Keep values inside the documented constraints"
    ],
    "dont": [
      "Do not place credentials in the BONE",
      "Do not invent unsupported MCP parameters"
    ]
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "authoring_mode": "hybrid",
  "execution_routes": [
    {
      "type": "api",
      "label": "MiniMax API · Image Generation",
      "operation": "image_generation",
      "args": {
        "prompt": "{{assembled}}",
        "model": "{{model}}"
      }
    }
  ],
  "routing": {
    "server_id": "minimax"
  },
  "extensions": {
    "x-genlock-provider-source": {
      "server_id": "minimax",
      "operation": "image_generation",
      "transport": "api",
      "surface": "minimax-mcp-js (bundled reviewed package)",
      "discovered_at": "2026-08-31T22:59:20.671Z",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Creative instruction assembled by Genlock."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model ID from the model catalog (required)."
          }
        },
        "required": [
          "prompt",
          "model"
        ]
      }
    },
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "image-canvas",
      "accent": "cyan",
      "tagline": "A mapped image instrument for Image Generation.",
      "controls": {
        "prompt": {
          "kind": "prompt-canvas",
          "prominent": true
        },
        "model": {
          "kind": "model-cards",
          "source": "models",
          "prominent": true
        }
      },
      "groups": [
        {
          "id": "primary",
          "label": "Composition",
          "role": "primary",
          "fields": [
            "prompt",
            "model"
          ]
        }
      ],
      "output": {
        "kind": "image",
        "label": "Generated image"
      }
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.0.0"
    }
  }
}
