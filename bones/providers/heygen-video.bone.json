{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "heygen-video",
  "bone_version": "1.0.0",
  "label": "HeyGen Video",
  "description": "Multi-model video gateway via HeyGen (supports various underlying generators and avatar workflows).",
  "target": "video",
  "provider": "heygen",
  "attaches_to": [
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt / Script"
    },
    "start_image": {
      "type": "string",
      "required": false,
      "ui": "file",
      "label": "Start / Avatar Image"
    },
    "duration": {
      "type": "number",
      "required": false,
      "ui": "number",
      "default": 5,
      "label": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "16:9",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "label": "Aspect Ratio"
    },
    "avatar_id": {
      "type": "string",
      "required": false,
      "ui": "text",
      "label": "Avatar ID"
    },
    "voice_id": {
      "type": "string",
      "required": false,
      "ui": "text",
      "label": "Voice ID"
    }
  },
  "defaults": {
    "duration": 5,
    "aspect_ratio": "16:9"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt or short script for HeyGen video generation.\n\nRules:\n- When an avatar is involved, write natural spoken language.\n- For pure generative video, focus on visual motion and scene description.\n- Keep the request clear and self-contained.\n- Output only field values."
  },
  "output": {
    "format": "mp4",
    "target": "video_take",
    "completion_status": "review"
  },
  "requires": [
    "video_generation"
  ],
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "heygen-video",
      "execution_route": "api",
      "output": {
        "type": "video",
        "write_back": [
          "videoTake",
          "asset"
        ]
      }
    }
  }
}
