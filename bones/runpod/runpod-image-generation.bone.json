{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/bone.schema.json",
  "bone_id": "runpod-image-generation",
  "bone_version": "1.1.0",
  "label": "RunPod · Image Generation (own endpoints)",
  "description": "Image Generation (own endpoints) mapped from RunPod's reviewed Genlock provider contract.",
  "target": "image",
  "provider": "runpod",
  "attaches_to": [
    "metadata",
    "scene",
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt",
      "description": "Creative instruction assembled by Genlock."
    },
    "endpoint_id": {
      "type": "string",
      "required": true,
      "ui": "text",
      "label": "Serverless endpoint"
    },
    "input": {
      "type": "object",
      "required": false,
      "ui": "text",
      "label": "Endpoint input"
    }
  },
  "defaults": {},
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "v_setup_injection": {
      "enabled": true,
      "position": "append",
      "token_format": "natural"
    },
    "character_injection": {
      "enabled": true,
      "position": "prepend",
      "format": "name_and_description"
    },
    "max_length": 4000
  },
  "llm_instructions": {
    "writing_guide": "Write a concrete RunPod image prompt for Image Generation (own endpoints). Respect the discovered parameter contract and do not invent unsupported fields.",
    "do": [
      "Use the discovered parameter names",
      "Keep values inside the documented constraints"
    ],
    "dont": [
      "Do not place credentials in the BONE",
      "Do not invent unsupported MCP parameters"
    ]
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "authoring_mode": "hybrid",
  "execution_routes": [
    {
      "type": "api",
      "label": "RunPod adapter · Image Generation (own endpoints)",
      "operation": "image_generation",
      "args": {
        "prompt": "{{assembled}}",
        "endpoint_id": "{{endpoint_id}}",
        "input": "{{input}}"
      }
    }
  ],
  "routing": {
    "server_id": "runpod"
  },
  "extensions": {
    "x-genlock-provider-source": {
      "server_id": "runpod",
      "operation": "image_generation",
      "transport": "api",
      "surface": "RunPod adapter · Image Generation (own endpoints)",
      "discovered_at": "2026-08-16T20:17:23.545Z",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Creative instruction assembled by Genlock."
          },
          "endpoint_id": {
            "type": "string",
            "title": "Serverless endpoint"
          },
          "input": {
            "type": "object",
            "title": "Endpoint input"
          }
        },
        "required": [
          "prompt",
          "endpoint_id"
        ]
      }
    },
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "endpoint-bay",
      "accent": "amber",
      "tagline": "Patch a discovered serverless endpoint into the active production, then run its mapped worker controls.",
      "controls": {
        "endpoint_id": {
          "kind": "endpoint-cards",
          "source": "endpoints",
          "prominent": true
        },
        "prompt": {
          "kind": "prompt-canvas",
          "prominent": true,
          "hint": "The worker receives this as its primary prompt"
        },
        "input": {
          "kind": "json-patch",
          "label": "Worker input patch"
        }
      },
      "groups": [
        {
          "id": "patch",
          "label": "Endpoint and prompt",
          "role": "primary",
          "fields": [
            "endpoint_id",
            "prompt"
          ]
        },
        {
          "id": "advanced",
          "label": "Worker-specific input",
          "role": "advanced",
          "fields": [
            "input"
          ],
          "collapsed": true
        }
      ],
      "output": {
        "kind": "image",
        "label": "Endpoint result"
      }
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.1.0"
    }
  }
}
