{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.9.0/spec/bone.schema.json",
  "bone_id": "gpt-image",
  "bone_version": "1.1.0",
  "label": "GPT Image",
  "description": "A model-safe OpenAI GPT Image 2 instrument with exact size, quality, and background controls.",
  "target": "image",
  "provider": "openai",
  "attaches_to": [
    "shot",
    "scene",
    "metadata"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Prompt"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "gpt-image-2",
      "options": [
        "gpt-image-2"
      ],
      "label": "Model"
    },
    "size": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "auto",
      "options": [
        "auto",
        "1024x1024",
        "1536x1024",
        "1024x1536"
      ],
      "label": "Canvas size"
    },
    "quality": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "high",
      "options": [
        "auto",
        "low",
        "medium",
        "high"
      ],
      "label": "Quality"
    },
    "background": {
      "type": "string",
      "required": false,
      "ui": "select",
      "default": "auto",
      "options": [
        "auto",
        "opaque",
        "transparent"
      ],
      "label": "Background"
    }
  },
  "defaults": {
    "model": "gpt-image-2",
    "size": "auto",
    "quality": "high",
    "background": "auto"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 2000
  },
  "llm_instructions": {
    "writing_guide": "You are writing a prompt for OpenAI GPT Image / DALL·E generation.\n\nRules:\n- Be clear and explicit. This family follows instructions closely.\n- Describe composition, subject, lighting, and style in natural language.\n- When reference images are provided, state how they should be used (style, identity, composition).\n- Avoid conflicting instructions.\n- Output only field values."
  },
  "output": {
    "format": "png",
    "target": "start_frame",
    "completion_status": "review"
  },
  "requires": [
    "image_generation"
  ],
  "routing": {
    "supported_models": [
      "gpt-image-2"
    ],
    "server_id": "openai"
  },
  "extensions": {
    "x-grok-source": {
      "dialect": "grok-draft-2026-07",
      "original_id": "gpt-image",
      "execution_route": "api",
      "output": {
        "type": "image",
        "write_back": [
          "startFrameImage",
          "endFrameImage",
          "asset"
        ]
      }
    },
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "image-canvas",
      "accent": "cyan",
      "tagline": "Compose a GPT Image 2 render with controls that map exactly to the OpenAI Images API.",
      "controls": {
        "prompt": {
          "kind": "prompt-canvas",
          "prominent": true
        },
        "model": {
          "kind": "model-cards",
          "source": "models",
          "prominent": true
        },
        "size": {
          "kind": "choice-chips"
        },
        "quality": {
          "kind": "choice-chips"
        },
        "background": {
          "kind": "choice-chips"
        }
      },
      "groups": [
        {
          "id": "primary",
          "label": "Image brief",
          "role": "primary",
          "fields": [
            "prompt",
            "model"
          ]
        },
        {
          "id": "delivery",
          "label": "Canvas and delivery",
          "role": "delivery",
          "fields": [
            "size",
            "quality",
            "background"
          ]
        }
      ],
      "output": {
        "kind": "image",
        "label": "Png output"
      }
    },
    "x-genlock-provider-source": {
      "server_id": "openai",
      "operation": "image_generation",
      "transport": "api",
      "surface": "Openai Image Generation"
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.1.0"
    }
  },
  "execution_routes": [
    {
      "type": "api",
      "label": "Openai Image Generation",
      "operation": "image_generation",
      "args": {
        "prompt": "{{assembled}}",
        "model": "{{model}}",
        "size": "{{size}}",
        "quality": "{{quality}}",
        "background": "{{background}}"
      }
    }
  ]
}
