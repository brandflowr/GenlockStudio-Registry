{
  "$schema": "https://spore.dev/schemas/bone/v1.0/bone.schema.json",
  "bone_id": "genlock-image",
  "bone_version": "1.2.0",
  "label": "Genlock Image — Structured",
  "description": "Structured image prompt in the canonical Genlock frame: subject, scene, shot, lighting, color_palette, style. Serialized to the generator's prompt (mirrors the ai_generation.prompt_components shape). Runs via Higgsfield.",
  "provider": "higgsfield",
  "target": "image",
  "requires": [
    "image_generation"
  ],
  "attaches_to": [
    "shot",
    "scene",
    "metadata"
  ],
  "fields": {
    "subject": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Subject",
      "description": "Who or what is in frame, with key physical details."
    },
    "scene": {
      "type": "object",
      "required": false,
      "ui": "textarea",
      "label": "Scene",
      "description": "{ setting, time_of_day, atmosphere }"
    },
    "shot": {
      "type": "object",
      "required": false,
      "ui": "textarea",
      "label": "Shot",
      "description": "{ type, angle, lens, framing }"
    },
    "lighting": {
      "type": "object",
      "required": false,
      "ui": "textarea",
      "label": "Lighting",
      "description": "{ key, mood, color_temperature }"
    },
    "color_palette": {
      "type": "array",
      "required": false,
      "ui": "textarea",
      "label": "Color Palette",
      "description": "Array of palette descriptors."
    },
    "style": {
      "type": "object",
      "required": false,
      "ui": "textarea",
      "label": "Style",
      "description": "{ look, references, grain }"
    },
    "aspect_ratio": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Aspect Ratio",
      "options": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4"
      ],
      "default": "16:9"
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Model",
      "options": [
        "gpt_image_2"
      ],
      "default": "gpt_image_2"
    },
    "quality": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Quality",
      "options": [
        "low",
        "medium",
        "high"
      ],
      "default": "high",
      "description": "GPT Image 2 quality. Omit when the selected model does not expose this parameter."
    },
    "resolution": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Resolution",
      "options": [
        "1k",
        "2k",
        "4k"
      ],
      "default": "2k",
      "description": "GPT Image 2 output resolution. Omit when the selected model does not expose this parameter."
    }
  },
  "defaults": {
    "model": "gpt_image_2",
    "aspect_ratio": "16:9",
    "quality": "high",
    "resolution": "2k"
  },
  "output": {
    "format": "png",
    "target": "startFrameImage",
    "completion_status": "review"
  },
  "execution": {
    "mcp": "generate_image",
    "skill": "higgsfield-generate",
    "wait": true,
    "json": true
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{subject}}. Scene: {{scene}}. Shot: {{shot}}. Lighting: {{lighting}}. Palette: {{color_palette}}. Style: {{style}}.",
    "v_setup_injection": {
      "enabled": true,
      "position": "inline",
      "token_format": "natural",
      "tokens": [
        "size",
        "angle",
        "lens",
        "light",
        "dof",
        "color",
        "aspect"
      ],
      "note": "v_setup is fallback context. Prefer the structured shot/lighting fields when populated."
    },
    "character_injection": {
      "enabled": true,
      "position": "subject_prefix",
      "format": "name_and_description"
    },
    "max_length": 4000,
    "separator": " "
  },
  "llm_instructions": {
    "writing_guide": "Author the still as the canonical Genlock image frame, then Genlock serializes it to the generator prompt. Lead with subject; populate scene/shot/lighting/style/color_palette as structured objects. For gpt_image_2 prompts can be rich; for flux keep concise. Match aspect to the project unless this shot needs a different composition.",
    "field_guides": {
      "subject": "Subject and relevant physical details first.",
      "scene": "{ setting, time_of_day, atmosphere }.",
      "shot": "{ type, angle, lens, framing } — composition of the still.",
      "lighting": "{ key, mood, color_temperature }.",
      "color_palette": "3–4 concrete color names.",
      "style": "{ look, references, grain }.",
      "model": "gpt_image_2 narrative stills; flux_2 / flux_kontext photorealism; seedream_v4_5 stylized photoreal; nano_banana_2 fast.",
      "quality": "For gpt_image_2 use low, medium, or high. The current model default is high. Omit this field for models whose provider schema does not expose quality.",
      "resolution": "For gpt_image_2 use 1k, 2k, or 4k. The current model default is 2k. Omit this field for models whose provider schema does not expose resolution."
    },
    "do": [
      "Lead with the subject",
      "Populate the structured scene/shot/lighting/style objects",
      "Match aspect to the project setting"
    ],
    "dont": [
      "Write the model name into the prompt text",
      "Exceed 4000 chars for gpt_image_2 or 300 words for flux"
    ]
  },
  "extensions": {
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "image-canvas",
      "accent": "cyan",
      "tagline": "Structured image prompt in the canonical Genlock frame: subject, scene, shot, lighting, color_palette, style. Serialized to the generator's prompt (mirrors the ai_generation.prompt_components shape). Runs via Higgsfield.",
      "controls": {
        "subject": {
          "kind": "text"
        },
        "scene": {
          "kind": "json-patch"
        },
        "shot": {
          "kind": "json-patch"
        },
        "lighting": {
          "kind": "json-patch"
        },
        "color_palette": {
          "kind": "json-patch"
        },
        "style": {
          "kind": "json-patch"
        },
        "aspect_ratio": {
          "kind": "aspect-tiles"
        },
        "model": {
          "kind": "model-cards",
          "source": "models",
          "prominent": true
        },
        "quality": {
          "kind": "choice-chips"
        },
        "resolution": {
          "kind": "choice-chips"
        }
      },
      "groups": [
        {
          "id": "primary",
          "label": "Direction",
          "role": "primary",
          "fields": [
            "model"
          ]
        },
        {
          "id": "delivery",
          "label": "Frame and delivery",
          "role": "delivery",
          "fields": [
            "aspect_ratio",
            "quality",
            "resolution"
          ]
        },
        {
          "id": "advanced",
          "label": "Advanced direction",
          "role": "advanced",
          "fields": [
            "subject",
            "scene",
            "shot",
            "lighting",
            "color_palette",
            "style"
          ],
          "collapsed": true
        }
      ],
      "output": {
        "kind": "image",
        "label": "Png output"
      }
    },
    "x-genlock-mcp-source": {
      "server_id": "higgsfield",
      "tool_name": "generate_image",
      "transport": "mcp",
      "surface": "Higgsfield Image Generation"
    },
    "x-genlock-provider-source": {
      "server_id": "higgsfield",
      "operation": "image_generation",
      "transport": "mcp",
      "surface": "Higgsfield Image Generation",
      "tool_name": "generate_image"
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.2.0"
    }
  },
  "execution_routes": [
    {
      "type": "mcp",
      "label": "Higgsfield Image Generation",
      "tool": "generate_image",
      "operation": "image_generation",
      "args": {
        "params": {
          "model": "{{model}}",
          "prompt": "{{assembled}}",
          "aspect_ratio": "{{aspect_ratio}}"
        }
      }
    }
  ],
  "routing": {
    "server_id": "higgsfield"
  }
}
