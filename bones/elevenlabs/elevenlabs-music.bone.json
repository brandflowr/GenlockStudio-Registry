{
  "$schema": "https://raw.githubusercontent.com/brandflowr/SKELETON-Brandflowr/v2.10.0/spec/bone.schema.json",
  "bone_id": "elevenlabs-music",
  "bone_version": "1.2.0",
  "label": "ElevenLabs · Music",
  "description": "Compose an original music cue from a concise creative brief.",
  "provider": "elevenlabs",
  "target": "audio",
  "requires": [
    "music_generation"
  ],
  "attaches_to": [
    "metadata",
    "scene",
    "shot"
  ],
  "fields": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": "textarea",
      "label": "Music brief",
      "description": "Describe genre, instrumentation, pace, emotional arc, and intended edit use."
    },
    "model": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Music model",
      "default": "music_v1",
      "options": [
        "music_v1"
      ]
    },
    "music_length_ms": {
      "type": "number",
      "required": false,
      "ui": "number",
      "label": "Length (milliseconds)",
      "description": "Between 3,000 and 600,000 milliseconds.",
      "min": 3000,
      "max": 600000
    },
    "force_instrumental": {
      "type": "boolean",
      "required": false,
      "ui": "toggle",
      "label": "Instrumental only",
      "default": true
    },
    "output_format": {
      "type": "string",
      "required": false,
      "ui": "select",
      "label": "Audio quality",
      "default": "auto",
      "options": [
        "auto",
        "mp3_44100_128",
        "mp3_48000_192",
        "wav_44100"
      ]
    }
  },
  "defaults": {
    "model": "music_v1",
    "force_instrumental": true,
    "output_format": "auto"
  },
  "prompt_assembly": {
    "strategy": "template",
    "template": "{{prompt}}",
    "max_length": 4100
  },
  "output": {
    "format": "mp3",
    "target": "audio_take",
    "completion_status": "review"
  },
  "execution_routes": [
    {
      "type": "api",
      "label": "ElevenLabs Music",
      "operation": "music_generation",
      "args": {
        "prompt": "{{assembled}}",
        "model_id": "{{model}}",
        "music_length_ms": "{{music_length_ms}}",
        "force_instrumental": "{{force_instrumental}}"
      }
    }
  ],
  "routing": {
    "server_id": "elevenlabs"
  },
  "llm_instructions": {
    "writing_guide": "Write a production music brief with genre, tempo feel, instrumentation, and emotional progression. Avoid copyrighted artist or song imitation.",
    "do": [
      "Describe how the cue should evolve",
      "State whether vocals are wanted"
    ],
    "dont": [
      "Request a copyrighted song imitation",
      "Put credentials in the BONE"
    ]
  },
  "extensions": {
    "x-genlock-surface": {
      "version": "1.0",
      "archetype": "audio-lab",
      "accent": "rose",
      "tagline": "Compose an original music cue from a concise creative brief.",
      "controls": {
        "prompt": {
          "kind": "prompt-canvas",
          "prominent": true
        },
        "model": {
          "kind": "model-cards",
          "source": "models",
          "prominent": true
        },
        "music_length_ms": {
          "kind": "slider"
        },
        "force_instrumental": {
          "kind": "switch"
        },
        "output_format": {
          "kind": "choice-chips"
        }
      },
      "groups": [
        {
          "id": "primary",
          "label": "Voice and script",
          "role": "primary",
          "fields": [
            "prompt",
            "model"
          ]
        },
        {
          "id": "performance",
          "label": "Performance",
          "role": "performance",
          "fields": [
            "music_length_ms",
            "force_instrumental"
          ]
        },
        {
          "id": "delivery",
          "label": "Audio delivery",
          "role": "delivery",
          "fields": [
            "output_format"
          ]
        }
      ],
      "output": {
        "kind": "audio",
        "label": "Mp3 output"
      }
    },
    "x-genlock-provider-source": {
      "server_id": "elevenlabs",
      "operation": "music_generation",
      "transport": "api",
      "surface": "ElevenLabs Music"
    },
    "x-genlock-surface-authoring": {
      "version": "1.0",
      "tool": "marketplace-surface-workshop",
      "revision": 1,
      "bone_version": "1.2.0"
    }
  }
}
